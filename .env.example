# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon / publishable — publique, protégée par la RLS>

# URL publique de l'app (liens des e-mails de connexion)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API → service_role (secrète, serveur uniquement).
# Nécessaire pour inviter des clients. Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
