# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<clé anon / publishable — publique, protégée par la RLS>

# URL publique de l'app (liens des e-mails de connexion)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API → service_role (secrète, serveur uniquement).
# Nécessaire pour inviter des clients. Ne jamais la préfixer NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Notifications e-mail (facultatif) — boîte OVH en SMTP.
# Sans SMTP_HOST / SMTP_USER / SMTP_PASS, aucun e-mail n'est envoyé (voir Admin → Logs : notify.skipped).
SMTP_HOST=ssl0.ovh.net
SMTP_PORT=465
SMTP_USER=app@martinvantalon.com
SMTP_PASS=
NOTIFY_FROM="Portail <app@martinvantalon.com>"
